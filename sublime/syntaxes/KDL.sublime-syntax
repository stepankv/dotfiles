%YAML 1.2
---
name: KDL
file_extensions: [kdl]
scope: source.kdl

contexts:
  main:
    - include: comments
    - include: strings
    - match: '\b(true|false|null)\b'
      scope: constant.language.kdl
    - match: '(?<![\w.-])[+-]?(?:0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|[0-9][0-9_]*(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(?![\w.-])'
      scope: constant.numeric.kdl
    - match: '\('
      scope: punctuation.definition.type.begin.kdl
      push: type
    - match: '[{}]'
      scope: punctuation.section.block.kdl
    - match: '[;=]'
      scope: punctuation.separator.kdl
    - match: '\\\s*$'
      scope: punctuation.separator.continuation.kdl
    - match: '[^\s\\/(){}<>;\[\]=",]+'
      scope: entity.name.tag.kdl

  strings:
    - match: 'r(#+)"'
      scope: punctuation.definition.string.begin.kdl
      push: raw-string
    - match: 'r"'
      scope: punctuation.definition.string.begin.kdl
      push: raw-string-unhashed
    - match: '"'
      scope: punctuation.definition.string.begin.kdl
      push: string

  string:
    - meta_scope: string.quoted.double.kdl
    - match: '\\(?:u\{[0-9a-fA-F]+\}|.)'
      scope: constant.character.escape.kdl
    - match: '"'
      scope: punctuation.definition.string.end.kdl
      pop: true

  raw-string:
    - meta_scope: string.quoted.double.raw.kdl
    - match: '"\1'
      scope: punctuation.definition.string.end.kdl
      pop: true

  raw-string-unhashed:
    - meta_scope: string.quoted.double.raw.kdl
    - match: '"'
      scope: punctuation.definition.string.end.kdl
      pop: true

  type:
    - meta_scope: storage.type.kdl
    - match: '\)'
      scope: punctuation.definition.type.end.kdl
      pop: true

  comments:
    - match: '//'
      scope: punctuation.definition.comment.kdl
      push:
        - meta_scope: comment.line.double-slash.kdl
        - match: '$'
          pop: true
    - match: '/\*'
      scope: punctuation.definition.comment.begin.kdl
      push: block-comment
    - match: '/-'
      scope: punctuation.definition.comment.kdl
      push: disabled-node

  block-comment:
    - meta_scope: comment.block.kdl
    - match: '/\*'
      push: block-comment
    - match: '\*/'
      scope: punctuation.definition.comment.end.kdl
      pop: true

  disabled-node:
    - meta_scope: comment.block.kdl
    - match: '"'
      push: disabled-string
    - match: '\{'
      push: disabled-children
    - match: ';|$|(?=\})'
      pop: true

  disabled-children:
    - meta_scope: comment.block.kdl
    - match: '"'
      push: disabled-string
    - match: '\{'
      push: disabled-children
    - match: '\}'
      pop: true

  disabled-string:
    - meta_scope: comment.block.kdl
    - match: '\\.'
    - match: '"'
      pop: true
